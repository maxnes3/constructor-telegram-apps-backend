generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NESTJS_DATABASE_URL")
}

model Templates {
  id                String     @id @default(uuid())
  name              String     @unique
  categoryId        String     @map("category_id")
  developId         String     @map("develop_id")
  runningId         String     @map("running_id")
  positionBehaviour String?    @map("position_behaviour")

  category          Categories @relation("TemplateToCategory", fields: [categoryId], references: [id])
  develop           Codebases  @relation("TemplateToDevelopCodebase", fields: [developId], references: [id])
  running           Codebases  @relation("TemplateToRunningCodebase", fields: [runningId], references: [id])
  screens           Screens[]  @relation("TemplatesToScreens")

  @@index([categoryId])
  @@index([developId])
  @@index([runningId])
  @@map("templates")
}

model Categories {
  id        String      @id @default(uuid())
  name      String

  templates Templates[] @relation("TemplateToCategory")

  @@map("categories")
}

model Codebases {
  id               String      @id @default(uuid())
  jsx              String
  scss             String?
  props            Json?

  developTemplates Templates[] @relation("TemplateToDevelopCodebase")
  runningTemplates Templates[] @relation("TemplateToRunningCodebase")

  @@map("codebases")
}

model Builds {
  id       String  @id @default(uuid())
  name     String  @unique
  code     String
  os       String  @default("all")
  isSource Boolean @map("is_root")

  @@map("builds")
}

model Screens {
  id            String      @id @default(uuid())
  name          String
  isStartScreen Boolean     @map("is_start_screen")
  projectId     String      @map("project_id")

  project       Projects    @relation("ProjectRelation", fields: [projectId], references: [id])
  templates     Templates[] @relation("TemplatesToScreens")

  @@map("screens")
}

model Projects {
  id      String    @id @default(uuid())
  name    String
  ownerId String    @map("owner_id")

  User    Users     @relation("UserRelation", fields: [ownerId], references: [id])
  screens Screens[] @relation("ProjectRelation")

  @@map("projects")
}

model Users {
  id       String     @id @default(uuid())
  email    String     @unique
  password String

  projects Projects[] @relation("UserRelation")

  @@map("users")
}