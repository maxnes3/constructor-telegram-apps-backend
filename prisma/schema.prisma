generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NESTJS_DATABASE_URL")
}

model Templates {
  id                String     @id @default(uuid())
  name              String     @unique
  categoryId        String     @map("category_id")
  demoId            String     @map("demo_id")
  prototypeId       String     @map("prototype_id")
  positionBehaviour String?    @map("position_behaviour")
  category          Categories @relation(fields: [categoryId], references: [id])
  demo              Builds     @relation(name: "DemoRelation", fields: [demoId], references: [id])
  prototype         Builds     @relation(name: "PrototypeRelation", fields: [prototypeId], references: [id])
  screens           Screens[]  @relation("TemplatesToScreens")

  @@map("templates")
}

model Categories {
  id        String      @id @default(uuid())
  name      String
  templates Templates[]

  @@map("categories")
}

model Builds {
  id                 String      @id @default(uuid())
  jsx                String
  scss               String?
  props              Json?
  demoTemplates      Templates[] @relation(name: "DemoRelation")
  prototypeTemplates Templates[] @relation(name: "PrototypeRelation")

  @@map("builds")
}

model Configs {
  id         String    @id @default(uuid())
  name       String    @unique
  code       String
  os         String    @default("all")
  isSource   Boolean   @map("is_root")

  @@map("configs")
}

model Screens {
  id            String       @id @default(uuid())
  name          String
  isStartScreen Boolean      @map("is_start_screen")
  projectId     String       @map("project_id")
  project       Projects     @relation(name: "ProjectRelation", fields: [projectId], references: [id])
  templates     Templates[]  @relation("TemplatesToScreens")

  @@map("screens")
}

model Projects {
  id       String     @id @default(uuid())
  name     String
  screens  Screens[]  @relation(name: "ProjectRelation")

  @@map("projects")
}